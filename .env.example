PUBLIC_PROFILE_SLUG=jonathan
MARKIT_PROFILE_URL=https://markitai.com/u/jonathan
FEED_NAME=jonathan-boston
CALENDAR_NAME=Jonathan Boston Upcoming Events

PAST_EVENT_RETENTION_HOURS=24
CANCELLED_RETENTION_DAYS=3
SYNC_STATE_DIR=.data
SITE_BASE_URL=https://your-public-site.example

# Optional only if you use the included Vercel handlers instead of GitHub Pages.
FEED_TOKEN=replace-with-a-long-random-token
CRON_SECRET=replace-with-a-long-random-secret
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token

# Movie release feed (run with FEED_NAME=movie-releases CALENDAR_NAME="Movie Release Dates")
# TMDB: read-only, no approval needed. Get a v4 token at https://www.themoviedb.org/settings/api
TMDB_READ_ACCESS_TOKEN=replace-with-a-tmdb-v4-read-access-token
MOVIE_LOOKAHEAD_DAYS=120

# AMC: catalog-only vendor key from https://developers.amctheatres.com/GettingStarted/NewVendorRequest
AMC_VENDOR_KEY=replace-with-an-amc-vendor-key
# Numeric AMC theatre ids (not slugs), comma-separated. Resolve with:
#   npm run resolve:amc-theatres -- "AMC Boston Common 19" "AMC Assembly Row 12"
AMC_THEATRE_IDS=replace-with-comma-separated-theatre-ids
